---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Sistema de Rifas FIIS - CEIIS UNI", 
  description = "Plataforma oficial de venta, asignación y seguimiento de rifas por códigos de la Facultad de Ingeniería Industrial y de Sistemas - UNI" 
} = Astro.props;
---

<!doctype html>
<html lang="es" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
      }
      h1, h2, h3, h4, .font-heading {
        font-family: 'Outfit', sans-serif;
      }
    </style>
  </head>
  <body class="text-slate-100 antialiased selection:bg-cyan-500/30 selection:text-cyan-200 min-h-screen flex flex-col justify-between">
    <!-- Ambient Light Background Orbs -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none -z-10">
      <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-blue-600/15 rounded-full blur-[140px]"></div>
      <div class="absolute top-1/3 -left-40 w-[500px] h-[500px] bg-indigo-600/10 rounded-full blur-[120px]"></div>
      <div class="absolute bottom-10 right-0 w-[600px] h-[450px] bg-cyan-600/10 rounded-full blur-[140px]"></div>
    </div>

    <!-- Header Navigation -->
    <header class="sticky top-0 z-50 glass-panel border-b border-cyan-500/20 bg-[#060621]/90">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-18 flex items-center justify-between">
        <!-- Brand Link: Solo texto RIFAS FIIS 2026 que lleva al inicio -->
        <a href="/" class="font-heading font-extrabold text-lg sm:text-xl tracking-tight text-white hover:text-cyan-300 transition-colors">
          RIFAS FIIS 2026
        </a>

        <!-- Desktop Navigation: Sin botón Inicio, botones iguales sin recuadros -->
        <nav class="hidden md:flex items-center gap-6 sm:gap-8">
          <a href="/vender" class="text-sm font-medium text-slate-300 hover:text-cyan-300 transition-colors">
            Registrar Venta
          </a>
          <a href="/#ranking" class="text-sm font-medium text-slate-300 hover:text-cyan-300 transition-colors">
            Ranking Códigos
          </a>
          <a href="/admin" class="text-sm font-medium text-slate-300 hover:text-cyan-300 transition-colors">
            Panel Admin / Deles
          </a>
        </nav>

        <!-- Mobile Quick Navigation -->
        <div class="md:hidden flex items-center gap-4 text-xs font-medium text-slate-300">
          <a href="/vender" class="hover:text-cyan-300 transition-colors">
            Registrar Venta
          </a>
          <a href="/admin" class="hover:text-cyan-300 transition-colors">
            Admin
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content Slot -->
    <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-cyan-500/10 bg-[#000c18]/90 py-6 text-center text-sm text-slate-400">
      <div class="max-w-7xl mx-auto px-4">
        <p>
          Impulsado por el CEIIS - Diseñado por Leonel Cruzado
        </p>
      </div>
    </footer>
  </body>
</html>
