---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Sistema de Rifas FIIS - CEIIS UNI", 
  description = "Plataforma oficial de venta, asignación y seguimiento de rifas por códigos de la Facultad de Ingeniería Industrial y de Sistemas - UNI" 
} = Astro.props;

const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="es" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/webp" href="/logo_ceiis_sin_fondo.webp" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
      }
      h1, h2, h3, h4, .font-heading {
        font-family: 'Outfit', sans-serif;
      }
    </style>
  </head>
  <body class="text-slate-100 antialiased selection:bg-cyan-500/30 selection:text-cyan-200 min-h-screen flex flex-col justify-between">
    <!-- Ambient Light Background Orbs -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none -z-10">
      <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-blue-600/15 rounded-full blur-[140px]"></div>
      <div class="absolute top-1/3 -left-40 w-[500px] h-[500px] bg-indigo-600/10 rounded-full blur-[120px]"></div>
      <div class="absolute bottom-10 right-0 w-[600px] h-[450px] bg-cyan-600/10 rounded-full blur-[140px]"></div>
    </div>

    <!-- Header Navigation: Se oculta al scrollear hacia abajo y reaparece al scrollear hacia arriba -->
    <header id="main-header" class="fixed top-0 inset-x-0 z-50 glass-panel border-b border-cyan-500/20 bg-[#060621]/90 transition-transform duration-300">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-18 flex items-center justify-between">
        <!-- Brand Logos: logo-black y logo_ceiis_sin_fondo en formato .webp (ambos presionables que llevan al inicio) -->
        <a href="/" class="flex items-center gap-2.5 sm:gap-4 group transition-transform active:scale-95 py-1" aria-label="Ir al inicio - Rifas FIIS 2026">
          <img
            src="/logo-black.webp"
            alt="Logo Semana FIIS"
            class="h-8 sm:h-10 w-auto object-contain transition-all duration-300 group-hover:brightness-125 group-hover:drop-shadow-[0_0_12px_rgba(59,130,246,0.8)]"
          />
          <img
            src="/logo_ceiis_sin_fondo.webp"
            alt="Logo CEIIS"
            class="h-9 sm:h-11 w-auto object-contain transition-all duration-300 group-hover:brightness-110 group-hover:drop-shadow-[0_0_14px_rgba(0,240,255,0.7)]"
          />
        </a>

        <!-- Desktop Navigation: Se ilumina con brillo neón la sección activa -->
        <nav class="hidden md:flex items-center gap-6 sm:gap-8">
          <a
            href="/vender"
            class={`text-sm transition-all ${
              pathname.startsWith('/vender')
                ? 'text-cyan-300 font-bold drop-shadow-[0_0_12px_rgba(0,240,255,0.8)]'
                : 'text-slate-300 hover:text-cyan-300 font-medium'
            }`}
          >
            Registrar Venta
          </a>
          <a
            href="/ranking"
            class={`text-sm transition-all ${
              pathname.startsWith('/ranking')
                ? 'text-cyan-300 font-bold drop-shadow-[0_0_12px_rgba(0,240,255,0.8)]'
                : 'text-slate-300 hover:text-cyan-300 font-medium'
            }`}
          >
            Ranking Códigos
          </a>
          <a
            href="/consultar"
            class={`text-sm transition-all ${
              pathname.startsWith('/consultar') || pathname.startsWith('/ticket')
                ? 'text-cyan-300 font-bold drop-shadow-[0_0_12px_rgba(0,240,255,0.8)]'
                : 'text-slate-300 hover:text-cyan-300 font-medium'
            }`}
          >
            Consultar Boleto
          </a>
          <a
            href="/panel"
            class={`text-sm transition-all ${
              pathname.startsWith('/panel') || pathname.startsWith('/admin') || pathname.startsWith('/delegados')
                ? 'text-cyan-300 font-bold drop-shadow-[0_0_12px_rgba(0,240,255,0.8)]'
                : 'text-slate-300 hover:text-cyan-300 font-medium'
            }`}
          >
            Panel
          </a>
        </nav>

        <!-- Mobile Menu Button (Ícono de lista / cuadro) -->
        <div class="md:hidden">
          <button
            id="mobile-menu-btn"
            type="button"
            aria-label="Abrir menú"
            class="p-2.5 rounded-xl bg-slate-900/80 border border-cyan-500/30 text-cyan-300 hover:bg-cyan-500/10 hover:border-cyan-400 focus:outline-none transition-all shadow-[0_0_12px_rgba(0,240,255,0.15)]"
          >
            <!-- Icono de lista / hamburguesa -->
            <svg id="menu-icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <!-- Icono de cerrar (X) -->
            <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Dropdown Menu -->
      <div id="mobile-menu" class="hidden md:hidden border-t border-cyan-500/20 bg-[#060621]/95 backdrop-blur-xl px-4 py-4 space-y-2">
        <a
          href="/vender"
          class={`block px-4 py-3 rounded-xl text-sm transition-all ${
            pathname.startsWith('/vender')
              ? 'bg-cyan-500/15 text-cyan-300 font-bold border border-cyan-500/30 drop-shadow-[0_0_10px_rgba(0,240,255,0.4)]'
              : 'text-slate-300 hover:bg-white/5 hover:text-cyan-300 font-medium'
          }`}
        >
          Registrar Venta
        </a>
        <a
          href="/ranking"
          class={`block px-4 py-3 rounded-xl text-sm transition-all ${
            pathname.startsWith('/ranking')
              ? 'bg-cyan-500/15 text-cyan-300 font-bold border border-cyan-500/30 drop-shadow-[0_0_10px_rgba(0,240,255,0.4)]'
              : 'text-slate-300 hover:bg-white/5 hover:text-cyan-300 font-medium'
          }`}
        >
          Ranking Códigos
        </a>
        <a
          href="/consultar"
          class={`block px-4 py-3 rounded-xl text-sm transition-all ${
            pathname.startsWith('/consultar') || pathname.startsWith('/ticket')
              ? 'bg-cyan-500/15 text-cyan-300 font-bold border border-cyan-500/30 drop-shadow-[0_0_10px_rgba(0,240,255,0.4)]'
              : 'text-slate-300 hover:bg-white/5 hover:text-cyan-300 font-medium'
          }`}
        >
          Consultar Boleto
        </a>
        <a
          href="/panel"
          class={`block px-4 py-3 rounded-xl text-sm transition-all ${
            pathname.startsWith('/panel') || pathname.startsWith('/admin') || pathname.startsWith('/delegados')
              ? 'bg-cyan-500/15 text-cyan-300 font-bold border border-cyan-500/30 drop-shadow-[0_0_10px_rgba(0,240,255,0.4)]'
              : 'text-slate-300 hover:bg-white/5 hover:text-cyan-300 font-medium'
          }`}
        >
          Panel
        </a>
      </div>
    </header>

    <!-- Main Content Slot: Añadido pt-20 en móvil para que el navbar fijo no tape el contenido -->
    <main class="flex-1 w-full max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 pt-20 pb-8 sm:pt-24 sm:pb-12">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-cyan-500/10 bg-[#000c18]/90 py-6 text-center text-sm text-slate-400">
      <div class="max-w-7xl mx-auto px-4">
        <p>
          Impulsado por el CEIIS - Diseñado por Leonel Cruzado
        </p>
      </div>
    </footer>

    <!-- Script para abrir/cerrar el menú en celulares y ocultar/mostrar navbar al scrollear -->
    <script>
      const menuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const iconOpen = document.getElementById('menu-icon-open');
      const iconClose = document.getElementById('menu-icon-close');
      const header = document.getElementById('main-header');

      // Toggle menú móvil
      if (menuBtn && mobileMenu && iconOpen && iconClose) {
        menuBtn.addEventListener('click', () => {
          const isHidden = mobileMenu.classList.contains('hidden');
          if (isHidden) {
            mobileMenu.classList.remove('hidden');
            iconOpen.classList.add('hidden');
            iconClose.classList.remove('hidden');
          } else {
            mobileMenu.classList.add('hidden');
            iconOpen.classList.remove('hidden');
            iconClose.classList.add('hidden');
          }
        });
      }

      // Hide navbar on scroll down, show on scroll up
      let lastScrollY = window.scrollY;
      window.addEventListener('scroll', () => {
        if (!header) return;
        const currentScrollY = window.scrollY;
        
        // No ocultar si el menú móvil está abierto
        const isMenuOpen = mobileMenu && !mobileMenu.classList.contains('hidden');
        if (isMenuOpen) return;

        if (currentScrollY > lastScrollY && currentScrollY > 70) {
          // Deslizando hacia abajo -> ocultar navbar
          header.classList.add('-translate-y-full');
        } else {
          // Deslizando hacia arriba -> mostrar navbar
          header.classList.remove('-translate-y-full');
        }
        lastScrollY = currentScrollY;
      }, { passive: true });
    </script>
  </body>
</html>
