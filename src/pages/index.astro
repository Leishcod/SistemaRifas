---
import Layout from '../layouts/Layout.astro';
import { Leaderboard } from '../components/Leaderboard';
import { PROMO_CODES, TARGET_PER_PROMO } from '../data/students';
---

<Layout title="Gran Rifa FIIS 2026 — CEIIS UNI">
  <div class="space-y-16">
    <!-- Hero Section -->
    <section class="relative pt-8 pb-12 sm:pt-14 sm:pb-16 text-center space-y-6">
      <!-- Main Headline: Solo un título llamado RIFA FIIS -->
      <div class="space-y-4 max-w-4xl mx-auto">
        <h1 class="font-heading font-black text-6xl sm:text-7xl md:text-8xl tracking-tight text-white glow-text-cyan">
          RIFA FIIS
        </h1>
        <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto font-normal">
          Plataforma oficial de venta, asignación y seguimiento de rifas por códigos de ingreso.
          Boletos virtuales automáticos y envío instantáneo por WhatsApp.
        </p>
      </div>

      <!-- Hero Call To Action Buttons: Dos botones de igual tamaño y color celeste sólido sin degradado -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2 max-w-md mx-auto">
        <a
          href="/vender"
          class="w-full sm:w-56 py-3.5 px-6 rounded-xl bg-cyan-400 hover:bg-cyan-300 text-[#000c18] font-heading font-extrabold text-base text-center shadow-[0_0_25px_rgba(34,211,238,0.35)] transition-all active:scale-[0.98] flex items-center justify-center"
        >
          Registrar Venta
        </a>

        <a
          href="/consultar"
          class="w-full sm:w-56 py-3.5 px-6 rounded-xl bg-cyan-400 hover:bg-cyan-300 text-[#000c18] font-heading font-extrabold text-base text-center shadow-[0_0_25px_rgba(34,211,238,0.35)] transition-all active:scale-[0.98] flex items-center justify-center"
        >
          Consultar boleto
        </a>
      </div>

      <!-- Feature Highlight Cards (Full text, NO icons, glowing hover shade) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 max-w-5xl mx-auto pt-8 text-left">
        <div class="tech-card group p-5 cursor-default">
          <h4 class="font-heading font-bold text-white text-base tracking-wide group-hover:text-cyan-300 transition-colors">
            Acceso por Código
          </h4>
          <p class="text-xs text-slate-400 mt-2 leading-relaxed">
            Sin claves ni registros extensos: ingresas con tu código UNI y tu base se valida de inmediato.
          </p>
        </div>

        <div class="tech-card group p-5 cursor-default">
          <h4 class="font-heading font-bold text-white text-base tracking-wide group-hover:text-cyan-300 transition-colors">
            Boleto Digital QR
          </h4>
          <p class="text-xs text-slate-400 mt-2 leading-relaxed">
            Asignación automática correlativa para evitar duplicados y comprobante digital oficial descargable.
          </p>
        </div>

        <div class="tech-card group p-5 cursor-default">
          <h4 class="font-heading font-bold text-white text-base tracking-wide group-hover:text-cyan-300 transition-colors">
            Envío por WhatsApp
          </h4>
          <p class="text-xs text-slate-400 mt-2 leading-relaxed">
            Envía al comprador su ticket con números asignados y enlace de consulta en un solo clic.
          </p>
        </div>

        <div class="tech-card group p-5 cursor-default">
          <h4 class="font-heading font-bold text-white text-base tracking-wide group-hover:text-cyan-300 transition-colors">
            Revisión de Vouchers
          </h4>
          <p class="text-xs text-slate-400 mt-2 leading-relaxed">
            Delegados y organizadores supervisan capturas Yape/Plin para validar pagos transparentemente.
          </p>
        </div>
      </div>
    </section>

    <!-- Leaderboard / Ranking Section -->
    <section id="ranking" class="scroll-mt-24">
      <Leaderboard client:load />
    </section>

    <!-- Códigos Participantes List -->
    <section class="space-y-6 pt-4">
      <div class="text-center max-w-2xl mx-auto">
        <h2 class="font-heading font-bold text-2xl sm:text-3xl text-white">
          11 Códigos Participantes
        </h2>
        <p class="text-xs sm:text-sm text-slate-400 mt-1">
          Cada base tiene una meta asignada de {TARGET_PER_PROMO} rifas. Elige tu código para registrar tus ventas.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
        {PROMO_CODES.map((promo) => (
          <a
            href={`/vender?base=${promo}`}
            class="tech-card group p-4 text-center block"
          >
            <span class="text-xs uppercase tracking-wider text-slate-500 font-semibold block group-hover:text-cyan-400 transition-colors">
              Código
            </span>
            <span class="font-heading font-black text-2xl text-white group-hover:text-cyan-300 transition-colors">
              {promo}
            </span>
            <span class="text-[10px] text-slate-400 block mt-1">
              Meta: {TARGET_PER_PROMO} rifas
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- FAQ / Important Instructions Section -->
    <section class="glass-panel p-6 sm:p-8 rounded-2xl border border-cyan-500/20 space-y-6">
      <h3 class="font-heading font-bold text-xl text-white">
        ¿Cómo funciona el proceso de venta para cada alumno?
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs text-slate-300">
        <div class="space-y-2 p-4 rounded-xl bg-white/[0.02] border border-white/5">
          <span class="font-heading font-bold text-cyan-400 text-sm block">Paso 1: Cobro</span>
          <p>
            Vendes la rifa a tu familiar, amigo o compañero (S/. 5.00 cada una). Te pagan vía Yape, Plin o transferencia bancaria y te envían la captura del comprobante.
          </p>
        </div>

        <div class="space-y-2 p-4 rounded-xl bg-white/[0.02] border border-white/5">
          <span class="font-heading font-bold text-cyan-400 text-sm block">Paso 2: Registro en la Web</span>
          <p>
            Ingresas a la plataforma con tu código UNI (ej. <strong class="text-white">20244517G</strong>) y tu base. Registras el nombre del comprador, su teléfono, cantidad de rifas y subes la captura del voucher.
          </p>
        </div>

        <div class="space-y-2 p-4 rounded-xl bg-white/[0.02] border border-white/5">
          <span class="font-heading font-bold text-cyan-400 text-sm block">Paso 3: Envío de Boleto</span>
          <p>
            El sistema asigna los números de boleto automáticamente. Presionas el botón de WhatsApp y se le envía el boleto virtual oficial a su celular con su código QR.
          </p>
        </div>
      </div>
    </section>
  </div>
</Layout>
