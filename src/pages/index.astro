---
import Layout from "../layouts/Layout.astro";
import { PROMO_CODES } from "../data/students";
import qrPlin from "../assets/qr_plin.webp";

// Importación de imágenes oficiales de los premios de la rifa
import lunahuanaImg from "../assets/Premios/lunahuana.webp";
import smartwatchImg from "../assets/Premios/smartwatch.webp";
import billete100Img from "../assets/Premios/100so.webp";
import sorpresaImg from "../assets/Premios/sorpresa.webp";
import mochilaImg from "../assets/Premios/mochila.webp";
import billetesImg from "../assets/Premios/billetes.webp";
import roncocaImg from "../assets/Premios/roncoca.webp";
import tresCrucesImg from "../assets/Premios/tres_cruces.webp";
import fourlokoImg from "../assets/Premios/fourloko.webp";

// Importación de imágenes oficiales de los códigos desde src/assets/Codigos/
const codigoImages = import.meta.glob<{ default: ImageMetadata | string }>(
  "../assets/Codigos/*.webp",
  { eager: true },
);

function getCodigoImageUrl(promoCode: string): string | null {
  for (const path in codigoImages) {
    const fileName = path
      .split("/")
      .pop()
      ?.replace(/\.[^/.]+$/, "");
    if (fileName && fileName.toLowerCase() === promoCode.toLowerCase()) {
      const mod = codigoImages[path];
      if (typeof mod.default === "string") return mod.default;
      if (
        mod.default &&
        typeof mod.default === "object" &&
        "src" in mod.default
      ) {
        return (mod.default as any).src;
      }
    }
  }
  return null;
}

// =========================================================================
// SECCIÓN DE PREMIOS (EDITA AQUÍ FÁCILMENTE LOS TÍTULOS Y DESCRIPCIONES)
// =========================================================================

// PARTE 1: Premios para los compradores y ganadores del sorteo de la rifa
const PREMIOS_RIFA = [
  {
    badge: "PRIMER PREMIO",
    titulo: "Full Day a Lunahuaná para dos",
    imagen: lunahuanaImg.src,
    destacado: true,
  },
  {
    badge: "SEGUNDO PREMIO",
    titulo: "Smartwatch + Audífonos",
    imagen: smartwatchImg.src,
    destacado: false,
  },
  {
    badge: "TERCER PREMIO",
    titulo: "S/. 100 Soles",
    imagen: billete100Img.src,
    destacado: false,
  },
  {
    badge: "CUARTO PREMIO",
    titulo: "Premio Sorpresa",
    imagen: sorpresaImg.src,
    destacado: false,
  },
];

// PARTE 2: Premios para los 3 mejores códigos (bases más vendedoras)
const PREMIOS_CODIGOS = [
  {
    badge: "1° CÓDIGO",
    titulo: "Pack de Trago + Six Pack Tres Cruces + 20 Pases Directos",
    imagenes: [roncocaImg.src, tresCrucesImg.src],
    textoCentral: null,
    destacado: true,
  },
  {
    badge: "2° CÓDIGO",
    titulo: "Six Pack de Four Loko + 15 Pases Directos",
    imagenes: [fourlokoImg.src],
    textoCentral: null,
    destacado: false,
  },
  {
    badge: "3° CÓDIGO",
    titulo: "10 Pases Directos Adicionales",
    imagenes: [],
    textoCentral: "+10",
    destacado: false,
  },
];

// PARTE 3: Premio para el Estudiante Mejor Vendedor
const PREMIO_MEJOR_VENDEDOR = {
  badge: "Vendedor N°1 de la Facultad",
  titulo: "Premio al Mejor Vendedor FIIS",
  premioPrincipal: "Mochila Especial 150 Años UNI",
  premioEfectivo: "25% de SU Recaudación",
  descripcion:
    "Reconocimiento máximo al estudiante que venda la mayor cantidad de boletos. Recibe la mochila conmemorativa oficial de los 150 años de la UNI más el 25% del dinero recaudado en sus ventas.",
};
---

<Layout title="Gran Rifa FIIS 2026">
  <div class="space-y-16 sm:space-y-24">
    <!-- Hero Section: Centrada más abajo con espaciado vertical generoso -->
    <section class="relative pt-12 pb-8 sm:pt-20 sm:pb-16 lg:pt-28 lg:pb-20 text-center space-y-8">
      <!-- Punto 3: Aura de resplandor concéntrico detrás del título -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[320px] sm:w-[500px] h-[250px] sm:h-[350px] bg-gradient-to-tr from-cyan-500/20 via-blue-600/20 to-indigo-600/10 rounded-full blur-[90px] pointer-events-none -z-10"></div>

      <!-- Main Headline: Badge superior + Título RIFAS FIIS -->
      <div class="space-y-4 max-w-4xl mx-auto">
        <!-- Punto 1: Badge contextual con pulso neón -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 text-xs sm:text-sm font-semibold tracking-wide shadow-[0_0_15px_rgba(0,240,255,0.2)]">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
          Por el FIISTONAZO
        </div>

        <h1 class="font-heading font-black text-6xl sm:text-7xl md:text-8xl tracking-tight">
          <span class="rifa-hero-gradient">GRAN RIFA FIIS</span>
        </h1>
        <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto font-normal">
          Plataforma oficial de venta, asignación y seguimiento de rifas por
          códigos de ingreso. Boletos virtuales automáticos y envío instantáneo
          por WhatsApp.
        </p>
      </div>

      <!-- Hero Call To Action Buttons: Dos botones de igual tamaño y color celeste sólido sin degradado -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4 max-w-md mx-auto">
        <a
          href="/vender"
          class="w-full sm:w-56 py-3.5 px-6 rounded-xl bg-cyan-400 hover:bg-cyan-300 text-[#000c18] font-heading font-extrabold text-base text-center shadow-[0_0_25px_rgba(34,211,238,0.35)] transition-all active:scale-[0.98] flex items-center justify-center"
        >
          Registrar Venta
        </a>

        <a
          href="/consultar"
          class="w-full sm:w-56 py-3.5 px-6 rounded-xl bg-cyan-400 hover:bg-cyan-300 text-[#000c18] font-heading font-extrabold text-base text-center shadow-[0_0_25px_rgba(34,211,238,0.35)] transition-all active:scale-[0.98] flex items-center justify-center"
        >
          Consultar boleto
        </a>
      </div>

      <!-- Punto 5: Grid de 4 características (2x2 en celular, 4 en PC) con íconos representativos -->
      <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 max-w-5xl mx-auto pt-8">
        <div class="tech-card group p-4 sm:p-5 cursor-default flex flex-col items-center justify-center text-center gap-2 min-h-[85px] sm:min-h-[90px]">
          <svg
            class="w-5 h-5 text-cyan-400 group-hover:scale-110 transition-transform"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.75"
              d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"
            />
          </svg>
          <h4 class="font-heading font-bold text-white text-xs sm:text-base tracking-wide group-hover:text-cyan-300 transition-colors">
            Acceso por Código
          </h4>
        </div>

        <div class="tech-card group p-4 sm:p-5 cursor-default flex flex-col items-center justify-center text-center gap-2 min-h-[85px] sm:min-h-[90px]">
          <svg
            class="w-5 h-5 text-cyan-400 group-hover:scale-110 transition-transform"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.75"
              d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"
            />
          </svg>
          <h4 class="font-heading font-bold text-white text-xs sm:text-base tracking-wide group-hover:text-cyan-300 transition-colors">
            Boleto Digital Oficial
          </h4>
        </div>

        <div class="tech-card group p-4 sm:p-5 cursor-default flex flex-col items-center justify-center text-center gap-2 min-h-[85px] sm:min-h-[90px]">
          <svg
            class="w-5 h-5 text-cyan-400 group-hover:scale-110 transition-transform"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.75"
              d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
            />
          </svg>
          <h4 class="font-heading font-bold text-white text-xs sm:text-base tracking-wide group-hover:text-cyan-300 transition-colors">
            Envío por WhatsApp
          </h4>
        </div>

        <div class="tech-card group p-4 sm:p-5 cursor-default flex flex-col items-center justify-center text-center gap-2 min-h-[85px] sm:min-h-[90px]">
          <svg
            class="w-5 h-5 text-cyan-400 group-hover:scale-110 transition-transform"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.75"
              d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
            />
          </svg>
          <h4 class="font-heading font-bold text-white text-xs sm:text-base tracking-wide group-hover:text-cyan-300 transition-colors">
            Revisión de Vouchers
          </h4>
        </div>
      </div>
    </section>

    <!-- Sección de Pago Oficial Plin -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="glass-panel p-6 sm:p-10 rounded-3xl border border-cyan-500/30 bg-gradient-to-br from-[#08152e]/90 via-[#0a1128]/95 to-[#052033]/90 relative overflow-hidden shadow-[0_0_50px_rgba(0,240,255,0.08)]">
        <!-- Ambient glow decoration -->
        <div class="absolute -top-24 -left-24 w-72 h-72 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -right-24 w-72 h-72 bg-blue-600/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 items-center relative z-10">
          <!-- Columna Izquierda: Información de Pago -->
          <div class="md:col-span-7 space-y-5 text-left">
            <div>
              <h2 class="font-heading font-black text-2xl sm:text-3xl lg:text-4xl text-white tracking-tight leading-tight">
                Canal Oficial de Recaudación
              </h2>
              <p class="text-sm sm:text-base text-slate-300 mt-2 leading-relaxed">
                Todo el dinero recaudado de la Gran Rifa FIIS debe enviarse{" "}
                <span class="text-cyan-300 font-bold">
                  única y exclusivamente mediante Plin
                </span>
                .
              </p>
            </div>

            <!-- Tarjeta de Datos de Plin -->
            <div class="p-4 sm:p-5 rounded-2xl bg-[#030716]/90 border border-cyan-500/25 space-y-3.5 shadow-inner">
              <div class="flex items-center justify-between pb-3 border-b border-white/10">
                <div>
                  <span class="text-[11px] uppercase tracking-wider text-slate-400 block font-semibold">
                    Titular de la cuenta
                  </span>
                  <span class="font-heading font-black text-lg sm:text-xl text-white tracking-wide">
                    MARIA JORGE
                  </span>
                </div>
              </div>

              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div>
                  <span class="text-[11px] uppercase tracking-wider text-slate-400 block font-semibold">
                    Número de celular
                  </span>
                  <span class="font-mono font-black text-2xl sm:text-3xl text-cyan-300 tracking-wider">
                    938284180
                  </span>
                </div>

                <button
                  type="button"
                  id="copy-plin-btn"
                  data-phone="938284180"
                  class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-cyan-500/20 hover:bg-cyan-500/30 border border-cyan-400/40 text-cyan-200 text-xs font-bold transition-all active:scale-95 shadow-sm cursor-pointer"
                >
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
                    />
                  </svg>
                  <span id="copy-text">Copiar Número</span>
                </button>
              </div>
            </div>

            <!-- Recordatorio de comprobante -->
            <div class="flex items-start gap-2.5 text-xs text-slate-300 bg-cyan-950/20 p-3 rounded-xl border border-cyan-500/15">
              <svg
                class="w-4 h-4 text-cyan-400 shrink-0 mt-0.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                />
              </svg>
              <span>
                <strong class="text-cyan-300">Recuerda:</strong>Al registrar tu
                venta, adjunta la captura del comprobante de Plin para que los
                boletos sean verificados y emitidos correctamente.
              </span>
            </div>
          </div>

          <!-- Columna Derecha: Código QR Plin -->
          <div class="md:col-span-5 flex flex-col items-center justify-center">
            <div class="relative group">
              <div class="absolute -inset-1.5 bg-gradient-to-r from-cyan-500 via-blue-500 to-indigo-500 rounded-3xl blur-md opacity-40 group-hover:opacity-75 transition duration-500"></div>

              <div class="relative bg-white rounded-2xl p-4 sm:p-5 shadow-2xl flex flex-col items-center">
                <img
                  src={qrPlin.src}
                  alt="Código QR Plin - MARIA JORGE 938 284 180"
                  class="w-56 h-auto sm:w-64 object-contain rounded-xl"
                  loading="lazy"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- SECCIÓN: PREMIOS DE LA GRAN RIFA FIIS      -->
    <!-- ========================================== -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 space-y-12 sm:space-y-16">
      <!-- Encabezado Principal de Premios -->
      <div class="text-center space-y-3">
        <h2 class="font-heading font-black text-3xl sm:text-4xl lg:text-5xl text-white tracking-tight">
          Premios de la Gran Rifa FIIS
        </h2>
      </div>

      <!-- PARTE 1: Premios de los Ganadores de la Rifa -->
      <div class="space-y-6">
        <div class="flex items-center gap-3 border-b border-cyan-500/20 pb-3">
          <span class="w-8 h-8 rounded-xl bg-cyan-500/20 text-cyan-300 border border-cyan-400/30 flex items-center justify-center font-heading font-black text-sm">
            1
          </span>
          <div>
            <h3 class="font-heading font-black text-xl sm:text-2xl text-white">
              Premios de los Ganadores de la Rifa
            </h3>
            <p class="text-xs sm:text-sm text-slate-400">
              Sorteo oficial entre todos los compradores con boletos válidos
              registrados.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8 justify-items-center pt-4">
          {PREMIOS_RIFA.map((p) => (
            <div class="flex flex-col items-center text-center space-y-3 sm:space-y-4 group w-full max-w-[220px]">
              {/* Badge de Premio */}
              <div
                class={`px-3.5 sm:px-4 py-1 rounded-full border text-[11px] sm:text-xs font-heading font-black tracking-wider uppercase transition-all duration-300 ${
                  p.destacado
                    ? "border-yellow-400 text-yellow-300 bg-yellow-400/10 shadow-[0_0_15px_rgba(250,204,21,0.35)]"
                    : "border-cyan-400 text-cyan-300 bg-cyan-400/10 shadow-[0_0_15px_rgba(0,240,255,0.25)]"
                }`}
              >
                {p.badge}
              </div>

              {/* Título del Premio (sin descripción) */}
              <div class="min-h-[44px] sm:min-h-[50px] flex items-center justify-center">
                <h4 class="font-heading font-black text-sm sm:text-base md:text-lg text-white group-hover:text-cyan-200 transition-colors leading-snug">
                  {p.titulo}
                </h4>
              </div>

              {/* Imagen Libre con Iluminado Neón (sin círculo contenedor) */}
              <div class="relative w-36 h-36 sm:w-44 sm:h-44 md:w-52 md:h-52 flex items-center justify-center">
                {/* Halo de luz difusa ambiental */}
                <div
                  class={`absolute inset-2 sm:inset-4 rounded-full blur-2xl -z-10 transition-all duration-500 pointer-events-none ${
                    p.destacado
                      ? "bg-yellow-400/30 group-hover:bg-yellow-400/50 group-hover:scale-110"
                      : "bg-cyan-400/25 group-hover:bg-cyan-400/40 group-hover:scale-110"
                  }`}
                ></div>

                {/* Imagen libre flotante con drop-shadow neón brillante */}
                <img
                  src={p.imagen}
                  alt={p.titulo}
                  class={`w-auto h-auto max-w-[90%] max-h-[90%] object-contain transition-transform duration-500 group-hover:scale-110 select-none ${
                    p.destacado
                      ? "drop-shadow-[0_0_20px_rgba(250,204,21,0.7)] group-hover:drop-shadow-[0_0_35px_rgba(250,204,21,0.95)]"
                      : "drop-shadow-[0_0_20px_rgba(0,240,255,0.6)] group-hover:drop-shadow-[0_0_35px_rgba(0,240,255,0.85)]"
                  }`}
                  loading="lazy"
                />
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- PARTE 2: Premios para los 3 Mejores Códigos -->
      <div class="space-y-6">
        <div class="flex items-center gap-3 border-b border-indigo-500/20 pb-3">
          <span class="w-8 h-8 rounded-xl bg-indigo-500/20 text-indigo-300 border border-indigo-400/30 flex items-center justify-center font-heading font-black text-sm">
            2
          </span>
          <div>
            <h3 class="font-heading font-black text-xl sm:text-2xl text-white">
              Premios para los 3 Mejores Códigos
            </h3>
            <p class="text-xs sm:text-sm text-slate-400">
              Incentivo exclusivo para los 3 códigos con mayor número de rifas
              vendidas.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 justify-items-center pt-4">
          {PREMIOS_CODIGOS.map((c) => (
            <div class="flex flex-col items-center text-center space-y-3 sm:space-y-4 group w-full max-w-[260px]">
              {/* Badge de Código */}
              <div
                class={`px-4 py-1 rounded-full border text-[11px] sm:text-xs font-heading font-black tracking-wider uppercase transition-all duration-300 ${
                  c.destacado
                    ? "border-yellow-400 text-yellow-300 bg-yellow-400/10 shadow-[0_0_15px_rgba(250,204,21,0.35)]"
                    : "border-cyan-400 text-cyan-300 bg-cyan-400/10 shadow-[0_0_15px_rgba(0,240,255,0.25)]"
                }`}
              >
                {c.badge}
              </div>

              {/* Título del Premio */}
              <div class="min-h-[48px] sm:min-h-[56px] flex items-center justify-center">
                <h4 class="font-heading font-black text-sm sm:text-base md:text-lg text-white group-hover:text-cyan-200 transition-colors leading-snug">
                  {c.titulo}
                </h4>
              </div>

              {/* Imagen Libre o Número Destacado con Iluminado Neón */}
              <div class="relative w-44 h-36 sm:w-56 sm:h-44 md:w-64 md:h-52 flex items-center justify-center">
                {/* Halo de luz difusa ambiental */}
                <div
                  class={`absolute inset-2 sm:inset-4 rounded-full blur-2xl -z-10 transition-all duration-500 pointer-events-none ${
                    c.destacado
                      ? "bg-yellow-400/30 group-hover:bg-yellow-400/50 group-hover:scale-110"
                      : "bg-cyan-400/25 group-hover:bg-cyan-400/40 group-hover:scale-110"
                  }`}
                ></div>

                {c.textoCentral ? (
                  <span class="font-heading font-black text-6xl sm:text-7xl md:text-8xl tracking-tight text-transparent bg-clip-text bg-gradient-to-b from-white via-cyan-200 to-cyan-400 drop-shadow-[0_0_25px_rgba(0,240,255,0.7)] group-hover:scale-110 group-hover:drop-shadow-[0_0_38px_rgba(0,240,255,0.95)] transition-all duration-500 select-none">
                    {c.textoCentral}
                  </span>
                ) : c.imagenes.length > 1 ? (
                  <div class="flex items-center justify-center gap-1.5 sm:gap-2 w-full h-full">
                    {c.imagenes.map((imgSrc, idx) => (
                      <img
                        src={imgSrc}
                        alt={`${c.titulo} ${idx + 1}`}
                        class={`w-auto h-auto max-w-[46%] max-h-[88%] object-contain transition-transform duration-500 group-hover:scale-105 select-none ${
                          c.destacado
                            ? "drop-shadow-[0_0_20px_rgba(250,204,21,0.7)] group-hover:drop-shadow-[0_0_35px_rgba(250,204,21,0.95)]"
                            : "drop-shadow-[0_0_20px_rgba(0,240,255,0.6)] group-hover:drop-shadow-[0_0_35px_rgba(0,240,255,0.85)]"
                        }`}
                        loading="lazy"
                      />
                    ))}
                  </div>
                ) : (
                  <img
                    src={c.imagenes[0]}
                    alt={c.titulo}
                    class={`w-auto h-auto max-w-[90%] max-h-[90%] object-contain transition-transform duration-500 group-hover:scale-110 select-none ${
                      c.destacado
                        ? "drop-shadow-[0_0_20px_rgba(250,204,21,0.7)] group-hover:drop-shadow-[0_0_35px_rgba(250,204,21,0.95)]"
                        : "drop-shadow-[0_0_20px_rgba(0,240,255,0.6)] group-hover:drop-shadow-[0_0_35px_rgba(0,240,255,0.85)]"
                    }`}
                    loading="lazy"
                  />
                )}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- PARTE 3: Premio para el Estudiante Mejor Vendedor -->
      <div class="space-y-6">
        <div class="flex items-center gap-3 border-b border-yellow-500/20 pb-3">
          <span class="w-8 h-8 rounded-xl bg-yellow-500/20 text-yellow-300 border border-yellow-400/30 flex items-center justify-center font-heading font-black text-sm">
            3
          </span>
          <div>
            <h3 class="font-heading font-black text-xl sm:text-2xl text-white">
              Premio al Mejor Vendedor
            </h3>
            <p class="text-xs sm:text-sm text-slate-400">
              Reconocimiento exclusivo para el o la estudiante con más boletos
              vendidos.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center pt-2">
          {/* Columna Izquierda: Información del Premio al Mejor Vendedor */}
          <div class="lg:col-span-6 space-y-5">
            <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-yellow-400/15 border border-yellow-400/40 text-yellow-300 text-xs font-bold tracking-wide shadow-[0_0_12px_rgba(250,204,21,0.25)]">
              <span class="w-2 h-2 rounded-full bg-yellow-400 animate-pulse"></span>
              {PREMIO_MEJOR_VENDEDOR.badge}
            </div>

            <h4 class="font-heading font-black text-2xl sm:text-3xl lg:text-4xl text-white tracking-tight">
              {PREMIO_MEJOR_VENDEDOR.titulo}
            </h4>

            {/* Cajas de premios apiladas verticalmente con colores invertidos (Azul arriba, Dorado abajo) */}
            <div class="flex flex-col gap-3.5 pt-1 max-w-lg">
              <div class="p-4 sm:p-5 rounded-2xl bg-[#030617]/90 border border-cyan-400/40 shadow-[0_0_20px_rgba(0,240,255,0.15)] flex items-center">
                <span class="font-heading font-black text-base sm:text-xl text-cyan-300">
                  {PREMIO_MEJOR_VENDEDOR.premioPrincipal}
                </span>
              </div>

              <div class="p-4 sm:p-5 rounded-2xl bg-[#030617]/90 border border-yellow-400/40 shadow-[0_0_20px_rgba(250,204,21,0.15)] flex items-center">
                <span class="font-heading font-black text-base sm:text-xl text-yellow-300">
                  {PREMIO_MEJOR_VENDEDOR.premioEfectivo}
                </span>
              </div>
            </div>
          </div>

          {/* Columna Derecha: Imágenes ampliadas de Mochila (Azul) + Dinero (Dorado) */}
          <div class="lg:col-span-6 flex items-center justify-center gap-4 sm:gap-8 pt-4 lg:pt-0">
            {/* Mochila con Iluminado Azul */}
            <div class="relative group flex items-center justify-center">
              <div class="absolute inset-1 sm:inset-2 rounded-full blur-3xl -z-10 bg-cyan-400/35 group-hover:bg-cyan-400/55 group-hover:scale-110 transition-all duration-500 pointer-events-none"></div>
              <img
                src={mochilaImg.src}
                alt="Mochila Oficial UNI 150 Años"
                class="w-40 h-40 sm:w-52 sm:h-52 md:w-60 md:h-60 lg:w-64 lg:h-64 object-contain drop-shadow-[0_0_25px_rgba(0,240,255,0.75)] group-hover:drop-shadow-[0_0_40px_rgba(0,240,255,1)] group-hover:scale-110 transition-transform duration-500 select-none"
                loading="lazy"
              />
            </div>

            {/* Símbolo '+' */}
            <span class="text-3xl sm:text-5xl font-heading font-black text-slate-300 drop-shadow-[0_0_12px_rgba(255,255,255,0.4)] select-none">
              +
            </span>

            {/* Dinero (billetes.webp) con Iluminado Dorado */}
            <div class="relative group flex items-center justify-center">
              <div class="absolute inset-1 sm:inset-2 rounded-full blur-3xl -z-10 bg-yellow-400/40 group-hover:bg-yellow-400/60 group-hover:scale-110 transition-all duration-500 pointer-events-none"></div>
              <img
                src={billetesImg.src}
                alt="25% de recaudación en efectivo"
                class="w-40 h-40 sm:w-52 sm:h-52 md:w-60 md:h-60 lg:w-64 lg:h-64 object-contain drop-shadow-[0_0_25px_rgba(250,204,21,0.8)] group-hover:drop-shadow-[0_0_40px_rgba(250,204,21,1)] group-hover:scale-110 transition-transform duration-500 select-none"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Códigos Participantes List -->
    <section class="space-y-15 pt-4 pb-24 sm:pb-36 lg:pb-48">
      <div class="text-center max-w-2xl mx-auto">
        <h2 class="font-heading font-bold text-3xl sm:text-4xl lg:text-5xl text-white">
          Códigos Participantes
        </h2>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3.5 sm:gap-4">
        {PROMO_CODES.map((promo) => {
          const imgUrl = getCodigoImageUrl(promo);
          const title = promo === "CEIIS" ? "CEIIS" : `CÓDIGO ${promo}`;

          return (
            <a
              href={`/vender?codigo=${promo}`}
              class="tech-card group p-4 sm:p-5 text-center flex flex-col items-center justify-between gap-3.5 transition-all duration-300 hover:border-cyan-400/50 hover:shadow-[0_0_20px_rgba(0,240,255,0.2)]"
            >
              <div class="relative w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-[#030617] border border-cyan-500/30 p-2 flex items-center justify-center shrink-0 shadow-lg group-hover:scale-105 group-hover:border-cyan-400 transition-all overflow-hidden">
                {imgUrl ? (
                  <img
                    src={imgUrl}
                    alt={`Logo ${title}`}
                    class="w-full h-full object-contain"
                    loading="lazy"
                  />
                ) : (
                  <span class="font-mono text-cyan-300 font-bold text-xs">
                    {promo}
                  </span>
                )}
              </div>

              <div>
                <h3 class="font-heading font-black text-sm sm:text-base text-white group-hover:text-cyan-300 transition-colors tracking-wide">
                  {title}
                </h3>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  </div>

  <script>
    const copyBtn = document.getElementById("copy-plin-btn");
    const copyText = document.getElementById("copy-text");

    if (copyBtn && copyText) {
      copyBtn.addEventListener("click", () => {
        const phone = copyBtn.getAttribute("data-phone") || "938284180";
        navigator.clipboard.writeText(phone).then(() => {
          copyText.textContent = "¡Copiado!";
          setTimeout(() => {
            copyText.textContent = "Copiar Número";
          }, 2000);
        });
      });
    }
  </script>
</Layout>
