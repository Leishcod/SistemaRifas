---
import Layout from "../layouts/Layout.astro";
import { Leaderboard } from "../components/Leaderboard";
---

<Layout title="Ranking Oficial — Gran Rifa FIIS 2026">
  <div class="space-y-8 sm:space-y-10">
    <div class="text-center max-w-xl mx-auto space-y-2.5">
      <h1 class="font-heading font-black text-3xl sm:text-4xl text-white">
        Ranking
      </h1>
      <p class="text-xs sm:!text-[16px] text-slate-300">
        Seguimiento y recaudación en tiempo real por cada código y CEIIS
      </p>
    </div>

    <!-- Leaderboard Component -->
    <Leaderboard client:load />
  </div>
</Layout>
