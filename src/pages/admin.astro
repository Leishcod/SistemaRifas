---
import Layout from "../layouts/Layout.astro";
import { AdminDashboard } from "../components/AdminDashboard";
---

<Layout title="Panel de Administración y Delegados — CEIIS UNI">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <a
        href="/"
        class="inline-flex items-center gap-1.5 text-xs text-cyan-400 hover:text-cyan-300 transition-colors"
      >
        <span>←</span> Volver al Inicio
      </a>
      <span class="text-xs text-slate-400 font-mono">Modo Seguro CEIIS</span>
    </div>

    <!-- Admin Dashboard React Component -->
    <AdminDashboard client:load />
  </div>
</Layout>
