---
import Layout from "../layouts/Layout.astro";
import { TicketViewer } from "../components/TicketViewer";
---

<Layout title="Consultar Boleto Oficial — Rifa FIIS 2026">
  <div class="space-y-6">
    <div class="text-center max-w-xl mx-auto space-y-2">
      <a
        href="/"
        class="inline-flex items-center gap-1.5 text-xs text-cyan-400 hover:text-cyan-300 transition-colors"
      >
        <span>←</span> Volver al Inicio
      </a>
      <h1 class="font-heading font-black text-3xl sm:text-4xl text-white">
        Verificador Oficial de Boletos
      </h1>
      <p class="text-xs sm:text-sm text-slate-300">
        Comprueba la autenticidad y estado de tu boleto.
      </p>
    </div>

    <!-- Ticket Viewer Component -->
    <TicketViewer client:load />
  </div>
</Layout>
