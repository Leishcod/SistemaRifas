---
import Layout from '../layouts/Layout.astro';
import { SellerRegistrationForm } from '../components/SellerRegistrationForm';
---

<Layout title="Registrar Venta de Rifa — CEIIS UNI">
  <div class="space-y-6">
    <!-- Breadcrumb / Header -->
    <div className="text-center max-w-xl mx-auto space-y-2">
      <h1 class="font-heading font-black text-3xl sm:text-4xl text-white">
        Portal del Vendedor FIIS
      </h1>
      <p class="text-xs sm:text-sm text-slate-300">
        Registra los compradores de tus rifas asignadas, sube el comprobante de Plin y genera sus boletos digitales oficiales.
      </p>
    </div>

    <!-- Interactive Seller Form Component -->
    <SellerRegistrationForm client:load />
  </div>
</Layout>
